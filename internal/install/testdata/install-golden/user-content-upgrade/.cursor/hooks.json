{
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "'/opt/new tools/zalki' '--state' '<HOME>/state' 'hook' '--agent' 'cursor'",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "'/opt/new tools/zalki' '--state' '<HOME>/state' 'hook' '--agent' 'cursor'",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "'/opt/new tools/zalki' '--state' '<HOME>/state' 'hook' '--agent' 'cursor'",
        "timeout": 5
      }
    ],
    "sessionStart": [
      {
        "command": "'/opt/new tools/zalki' '--state' '<HOME>/state' 'hook' '--agent' 'cursor'",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "echo mine"
      },
      {
        "command": "'/opt/new tools/zalki' '--state' '<HOME>/state' 'hook' '--agent' 'cursor'",
        "loop_limit": 5,
        "timeout": 5
      }
    ]
  },
  "version": 1
}
