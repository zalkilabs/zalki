            "command": "'/opt/zalki tools/zalki' '--state' '<HOME>/state' 'hook' '--agent' 'claude'",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "'/opt/zalki tools/zalki' '--state' '<HOME>/state' 'hook' '--agent' 'claude'",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "'/opt/zalki tools/zalki' '--state' '<HOME>/state' 'hook' '--agent' 'claude'",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'/opt/zalki tools/zalki' '--state' '<HOME>/state' 'hook' '--agent' 'claude'",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "echo mine",
